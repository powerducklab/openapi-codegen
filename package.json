{
  "name": "@powerduck/openapi-codegen",
  "version": "0.6.2",
  "description": "Generate runnable HTTP request examples from OpenAPI documents. 21 languages, 41 clients, browser-compatible, zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fuzz": "vitest run tests/fuzz.test.ts",
    "demo": "tsx demo/index.ts",
    "check": "npm test && npm run fuzz && npm run build",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "keywords": [
    "openapi",
    "codegen",
    "http-client",
    "api",
    "generator",
    "swagger",
    "rest",
    "typescript",
    "esm",
    "cjs",
    "browser"
  ],
  "license": "MIT",
  "author": "Powerduck limited",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerducklab/openapi-codegen.git"
  },
  "bugs": {
    "url": "https://github.com/powerducklab/openapi-codegen/issues"
  },
  "homepage": "https://www.powerduck.com/",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fast-check": "^4.0.0",
    "terser": "^5.51.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
